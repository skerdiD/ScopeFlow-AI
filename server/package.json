{
  "name": "scopeflow-ai-server",
  "version": "1.0.0",
  "description": "ScopeFlow AI backend API migrated to Express, TypeScript, and Prisma.",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:pull": "prisma db pull",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "seed:demo": "tsx prisma/seed.ts",
    "seed:demo:reset": "tsx prisma/seed.ts --reset"
  },
  "keywords": [
    "scopeflow",
    "express",
    "prisma"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "prisma": "6.12.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "pdfkit": "^0.20.2",
    "rate-limit-redis": "^4.2.1",
    "redis": "^5.8.2",
    "zod": "^4.6.5"
  }
}
