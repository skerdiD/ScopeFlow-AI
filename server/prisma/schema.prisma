generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DjangoUser {
  id           Int               @id @default(autoincrement())
  password     String            @db.VarChar(128)
  lastLogin    DateTime?         @map("last_login")
  isSuperuser  Boolean           @map("is_superuser")
  username     String            @unique @db.VarChar(150)
  firstName    String            @map("first_name") @db.VarChar(150)
  lastName     String            @map("last_name") @db.VarChar(150)
  email        String            @db.VarChar(254)
  isStaff      Boolean           @map("is_staff")
  isActive     Boolean           @map("is_active")
  dateJoined   DateTime          @map("date_joined")
  plan         UserPlan?
  usageRecords UsageRecord[]
  aiUsageLogs  AIUsageLog[]
  qualityReviews AIQualityReview[]

  @@map("auth_user")
}

model UserPlan {
  id        BigInt     @id @default(autoincrement())
  userId    Int        @unique @map("user_id")
  plan      String     @default("free") @db.VarChar(20)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      DjangoUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("proposals_userplan")
}

model UsageRecord {
  id                BigInt     @id @default(autoincrement())
  userId            Int        @map("user_id")
  period            DateTime   @db.Date
  aiGenerationsUsed Int        @default(0) @map("ai_generations_used")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  user              DjangoUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period], map: "unique_user_usage_period")
  @@index([period])
  @@index([userId, period], map: "usage_user_period_idx")
  @@map("proposals_usagerecord")
}

model AIPromptVersion {
  id             BigInt            @id @default(autoincrement())
  name           String            @db.VarChar(120)
  version        String            @db.VarChar(50)
  purpose        String            @db.VarChar(50)
  promptText     String            @map("prompt_text")
  isActive       Boolean           @default(false) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  usageLogs      AIUsageLog[]
  qualityReviews AIQualityReview[]

  @@unique([purpose, version], map: "unique_prompt_purpose_version")
  @@index([purpose])
  @@index([isActive])
  @@map("proposals_aipromptversion")
}

model ProposalProject {
  id                    BigInt                  @id @default(autoincrement())
  userId                String                  @map("user_id") @db.VarChar(255)
  clientName            String                  @map("client_name") @db.VarChar(255)
  projectName           String                  @map("project_name") @db.VarChar(255)
  projectType           String                  @map("project_type") @db.VarChar(120)
  budget                String                  @default("") @db.VarChar(120)
  timeline              String                  @default("") @db.VarChar(120)
  requirements          String                  @default("")
  summary               String                  @default("")
  scope                 String                  @default("")
  deliverables          String                  @default("")
  milestones            String                  @default("")
  proposalTimeline      String                  @default("") @map("proposal_timeline")
  pricing               String                  @default("")
  risks                 String                  @default("")
  nextSteps             String                  @default("") @map("next_steps")
  paymentUrl            String                  @default("") @map("payment_url") @db.VarChar(200)
  missingInformation    Json                    @default("[]") @map("missing_information")
  scopeRisks            Json                    @default("[]") @map("scope_risks")
  unclearRequirements   Json                    @default("[]") @map("unclear_requirements")
  suggestedQuestions    Json                    @default("[]") @map("suggested_questions")
  generatedProposal     Json                    @default("{}") @map("generated_proposal")
  currentVersionId      BigInt?                 @map("current_version_id")
  status                String                  @default("draft") @db.VarChar(50)
  shareToken            String?                 @unique @map("share_token") @db.VarChar(64)
  shareEnabled          Boolean                 @default(false) @map("share_enabled")
  shareCreatedAt        DateTime?               @map("share_created_at")
  viewedAt              DateTime?               @map("viewed_at")
  clientNameResponse    String                  @default("") @map("client_name_response") @db.VarChar(255)
  clientEmailResponse   String                  @default("") @map("client_email_response") @db.VarChar(254)
  clientResponseComment String                  @default("") @map("client_response_comment")
  approvedAt            DateTime?               @map("approved_at")
  rejectedAt            DateTime?               @map("rejected_at")
  isDemo                Boolean                 @default(false) @map("is_demo")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  currentVersion        ProposalVersion?        @relation("CurrentProjectVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions              ProposalVersion[]       @relation("ProjectVersions")
  clientComments        ProposalClientComment[]
  aiUsageLogs           AIUsageLog[]
  qualityReviews        AIQualityReview[]

  @@index([userId])
  @@index([userId, updatedAt], map: "proposal_user_updated_idx")
  @@map("proposals_proposalproject")
}

model ProposalVersion {
  id                BigInt            @id @default(autoincrement())
  projectId         BigInt            @map("project_id")
  versionNumber     Int               @map("version_number")
  label             String            @db.VarChar(50)
  source            String            @default("manual") @db.VarChar(50)
  changedSections   Json              @default("[]") @map("changed_sections")
  summary           String            @default("")
  scope             String            @default("")
  deliverables      String            @default("")
  milestones        String            @default("")
  proposalTimeline  String            @default("") @map("proposal_timeline")
  pricing           String            @default("")
  risks             String            @default("")
  nextSteps         String            @default("") @map("next_steps")
  isFinal           Boolean           @default(false) @map("is_final")
  createdAt         DateTime          @default(now()) @map("created_at")
  project           ProposalProject   @relation("ProjectVersions", fields: [projectId], references: [id], onDelete: Cascade)
  currentForProject ProposalProject[] @relation("CurrentProjectVersion")
  qualityReviews    AIQualityReview[]

  @@index([projectId, isFinal, createdAt], map: "proposal_ver_export_idx")
  @@map("proposals_proposalversion")
}

model ProposalClientComment {
  id          BigInt          @id @default(autoincrement())
  projectId   BigInt          @map("project_id")
  clientName  String          @default("") @map("client_name") @db.VarChar(255)
  clientEmail String          @default("") @map("client_email") @db.VarChar(254)
  comment     String
  createdAt   DateTime        @default(now()) @map("created_at")
  project     ProposalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("proposals_proposalclientcomment")
}

model AIUsageLog {
  id             BigInt            @id @default(autoincrement())
  userId         Int               @map("user_id")
  projectId      BigInt?           @map("project_id")
  actionType     String            @map("action_type") @db.VarChar(50)
  status         String            @db.VarChar(20)
  promptVersionId BigInt?          @map("prompt_version_id")
  errorMessage   String            @default("") @map("error_message")
  inputTokens    Int?              @map("input_tokens")
  outputTokens   Int?              @map("output_tokens")
  totalTokens    Int?              @map("total_tokens")
  estimatedCost  Decimal?          @map("estimated_cost") @db.Decimal(10, 6)
  createdAt      DateTime          @default(now()) @map("created_at")
  user           DjangoUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        ProposalProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  promptVersion  AIPromptVersion?  @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([actionType])
  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt], map: "ai_usage_user_created_idx")
  @@index([actionType, createdAt], map: "ai_usage_action_created_idx")
  @@map("proposals_aiusagelog")
}

model AIQualityReview {
  id                BigInt           @id @default(autoincrement())
  projectId         BigInt           @map("project_id")
  userId            Int              @map("user_id")
  proposalVersionId BigInt?          @map("proposal_version_id")
  score             Int
  summary           String
  strengths         Json             @default("[]")
  weaknesses        Json             @default("[]")
  recommendations   Json             @default("[]")
  promptVersionId   BigInt?          @map("prompt_version_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  project           ProposalProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user              DjangoUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposalVersion   ProposalVersion? @relation(fields: [proposalVersionId], references: [id], onDelete: SetNull)
  promptVersion     AIPromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt], map: "ai_review_project_created_idx")
  @@map("proposals_aiqualityreview")
}
