# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8000
TRUST_PROXY=0
API_PREFIX=/api

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
FRONTEND_URL=https://scope-flow-ai.vercel.app
VERCEL_URL=

# Supabase PostgreSQL (required for real API/database access)
# Example:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Supabase Auth (required for backend token verification)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_AUTH_CACHE_TTL=30

# API limits / payload controls
JSON_BODY_LIMIT=1mb
RATE_LIMIT_ANON=120/min
RATE_LIMIT_USER=600/min
RATE_LIMIT_GENERATE_PROPOSAL=30/hour
RATE_LIMIT_GENERATE_TEMPLATE=30/hour
RATE_LIMIT_GENERATE_AI_ACTION=60/hour

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public demo account identity used for backend demo-mode protections
DEMO_ACCOUNT_EMAIL=demo@scopeflow.ai
