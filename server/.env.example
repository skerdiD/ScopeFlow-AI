# Required in production. Use a strong unique value from your host secret manager.
SECRET_KEY=replace-with-django-secret

# Local development can use True. Production should be False.
DEBUG=True

# Comma-separated backend hosts. On Render, include your .onrender.com host or rely on RENDER_EXTERNAL_HOSTNAME.
ALLOWED_HOSTS=127.0.0.1,localhost,scopeflow-ai.onrender.com

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional. If omitted, the backend trusts the configured CORS origins for CSRF.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Production frontend URL, for example your Vercel deployment.
FRONTEND_URL=https://scope-flow-ai.vercel.app

# Supabase PostgreSQL (required)
# Example:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Supabase Auth (required for backend token verification)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_AUTH_CACHE_TTL=30

# Optional database tuning
DATABASE_CONN_MAX_AGE=60
# Override only when needed (for local non-SSL PostgreSQL, use disable)
DATABASE_SSL_MODE=require

# Optional API hardening / abuse controls
DRF_THROTTLE_ANON=120/min
DRF_THROTTLE_USER=600/min
DRF_THROTTLE_GENERATE_PROPOSAL=30/hour
DRF_THROTTLE_GENERATE_TEMPLATE=30/hour
DATA_UPLOAD_MAX_MEMORY_SIZE=1048576
FILE_UPLOAD_MAX_MEMORY_SIZE=1048576
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
